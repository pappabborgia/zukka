# Origin that serves the games (the "play" project). No trailing slash.
NEXT_PUBLIC_PLAY_ORIGIN=http://127.0.0.1:3001
# Public address of this site (used in the sign-in links). No trailing slash.
APP_ORIGIN=http://localhost:3000

# Local development: the Firebase emulators (npm run dev:emu starts them). No real project needed.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=demo-zukka

# Production (Vercel), instead of the three lines above:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=web API key from Project settings > General
# FIREBASE_CLIENT_EMAIL=service account email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# SESSION_SECRET=at least 32 random characters

# CRON_SECRET=at least 16 random characters (Vercel Cron calls /api/cron/nightly with it)

# Optional: send sign-in emails with Resend. Without these, Firebase sends them (few per day on the free plan);
# in local development with the emulators the link is shown on screen.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Zukka <login@your-verified-domain>"
# EMAIL_REPLY_TO=optional address for replies
