rules_version = '2';

// Zukka keeps every read and write on the server (Next.js route handlers and server
// actions with the Admin SDK, which is not subject to these rules). Browsers never talk
// to Firestore directly, so the rules deny everything: if a key or token ever leaked to a
// browser, it still could not read or change any data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
